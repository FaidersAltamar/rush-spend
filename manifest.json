{
  "manifest_version": 3,
  "name": "RUSH Spend",
  "version": "1.14.1",
  "description": "Gastos, límites y estados de todas las cuentas de Facebook en un clic. Herramienta gratuita de la comunidad RUSH.",
  "action": {
    "default_popup": "app.html",
    "default_title": "RUSH Spend"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://graph.facebook.com/*",
    "https://*.facebook.com/*"
  ],
  "optional_host_permissions": [
    "https://open.er-api.com/*",
    "https://*/*",
    "http://*/*"
  ]
}
